.page{min-height:100vh;background:#fff;padding:0 40rpx}.login-header{display:flex;flex-direction:column;align-items:center;padding:120rpx 0 80rpx}.login-header .logo{width:160rpx;height:160rpx;border-radius:32rpx;background:linear-gradient(135deg,#1e88e5,#1565c0);display:flex;align-items:center;justify-content:center}.login-header .logo text{font-size:72rpx;font-weight:700;color:#fff}.login-header .title{font-size:48rpx;font-weight:700;color:#333;margin-top:30rpx}.login-header .subtitle{font-size:28rpx;color:#999;margin-top:12rpx}.login-form .input-group{margin-bottom:30rpx}.login-form .input-group .input-label{font-size:28rpx;color:#333;font-weight:500;margin-bottom:16rpx;display:block}.login-form .input-group .input{width:100%;height:96rpx;padding:0 30rpx;background:#f5f5f5;border-radius:16rpx;font-size:28rpx}.login-form .input-group .code-input{display:flex;gap:20rpx}.login-form .input-group .code-input .input{flex:1}.login-form .input-group .code-input .code-btn{width:200rpx;height:96rpx;background:#1e88e5;border-radius:16rpx;display:flex;align-items:center;justify-content:center}.login-form .input-group .code-input .code-btn text{font-size:26rpx;color:#fff;font-weight:700}.login-form .input-group .code-input .code-btn.disabled{background:#ccc}.login-form .login-btn{height:96rpx;background:linear-gradient(135deg,#1e88e5,#1565c0);border-radius:48rpx;font-size:32rpx;font-weight:700;color:#fff;margin-top:40rpx}.tips{margin-top:60rpx;text-align:center}.tips text{font-size:24rpx;color:#999}

.page{min-height:100vh;background:#f5f5f5}.product-header{display:flex;background:#fff;padding:30rpx}.product-header .product-image{width:180rpx;height:180rpx;border-radius:16rpx;background:#f5f5f5}.product-header .product-info{flex:1;margin-left:24rpx;display:flex;flex-direction:column;justify-content:center}.product-header .product-info .product-name{font-size:32rpx;color:#333;font-weight:700}.product-header .product-info .product-price{font-size:36rpx;color:#e53734;font-weight:700;margin-top:16rpx}.stock-card{background:#fff;margin:20rpx;border-radius:16rpx;padding:30rpx}.stock-card .stock-row{display:flex;justify-content:space-around}.stock-card .stock-item{display:flex;flex-direction:column;align-items:center}.stock-card .stock-item .item-value{font-size:48rpx;font-weight:700;color:#1e88e5}.stock-card .stock-item .item-value.warning{color:#ff9800}.stock-card .stock-item .item-value.lock{color:#f44336}.stock-card .stock-item .item-label{font-size:24rpx;color:#999;margin-top:8rpx}.stock-card .warning-row{display:flex;justify-content:space-between;align-items:center;margin-top:24rpx;padding-top:24rpx;border-top:1rpx solid #f5f5f5}.stock-card .warning-row .warning-label{font-size:26rpx;color:#666}.stock-card .warning-row .warning-text{font-size:26rpx;color:#ff9800;font-weight:700}.section{margin:20rpx}.section .section-header{margin-bottom:16rpx}.section .section-title{font-size:30rpx;font-weight:700;color:#333}.section .log-list{background:#fff;border-radius:16rpx;overflow:hidden}.section .log-item{display:flex;justify-content:space-between;padding:24rpx 30rpx;border-bottom:1rpx solid #f5f5f5}.section .log-item:last-child{border-bottom:none}.section .log-item .log-left{display:flex;align-items:center;gap:16rpx}.section .log-item .log-left .log-type{padding:6rpx 16rpx;border-radius:8rpx;font-size:22rpx;font-weight:700}.section .log-item .log-left .log-type.in{background:#e8f5e9;color:#4caf50}.section .log-item .log-left .log-type.out{background:#ffebee;color:#f44336}.section .log-item .log-left .log-type.adjust{background:#fff3e0;color:#ff9800}.section .log-item .log-left .log-reason{font-size:28rpx;color:#333}.section .log-item .log-right{display:flex;flex-direction:column;align-items:flex-end}.section .log-item .log-right .log-qty{font-size:28rpx;font-weight:700;color:#f44336}.section .log-item .log-right .log-qty.plus{color:#4caf50}.section .log-item .log-right .log-time{font-size:22rpx;color:#999;margin-top:4rpx}.section .empty{padding:60rpx;text-align:center}.section .empty text{font-size:28rpx;color:#999}

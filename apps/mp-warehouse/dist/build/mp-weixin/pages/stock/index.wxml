<view class="page"><view class="search-bar"><input placeholder="搜索商品名称" class="search-input" bindconfirm="{{a}}" value="{{b}}" bindinput="{{c}}"/><view class="filter-btn" bindtap="{{d}}"><text>筛选</text></view></view><view class="filter-tags"><view class="{{['tag', e]}}" bindtap="{{f}}"><text>库存预警</text></view></view><view class="stock-list"><view wx:for="{{g}}" wx:for-item="item" wx:key="j" class="stock-item" bindtap="{{item.k}}"><image src="{{item.a}}" mode="aspectFill" class="stock-image"/><view class="stock-info"><text class="stock-name">{{item.b}}</text><view class="stock-data"><view class="data-item"><text class="data-label">库存</text><text class="{{['data-value', item.e]}}">{{item.c}}{{item.d}}</text></view><view class="data-item"><text class="data-label">可用</text><text class="data-value">{{item.f}}{{item.g}}</text></view><view class="data-item"><text class="data-label">锁定</text><text class="data-value lock">{{item.h}}{{item.i}}</text></view></view></view><view class="arrow">&gt;</view></view><view wx:if="{{h}}" class="empty"><text>暂无库存数据</text></view></view><view wx:if="{{i}}" class="loading"><text>加载中...</text></view></view>
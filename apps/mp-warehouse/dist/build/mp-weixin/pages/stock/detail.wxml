<view class="page"><view class="product-header"><image src="{{a}}" mode="aspectFill" class="product-image"/><view class="product-info"><text class="product-name">{{b}}</text><text class="product-price">¥{{c}}</text></view></view><view class="stock-card"><view class="stock-row"><view class="stock-item"><text class="{{['item-value', e && 'warning']}}">{{d}}</text><text class="item-label">当前库存</text></view><view class="stock-item"><text class="item-value">{{f}}</text><text class="item-label">可用库存</text></view><view class="stock-item"><text class="item-value lock">{{g}}</text><text class="item-label">锁定库存</text></view></view><view class="warning-row"><text class="warning-label">预警阈值: {{h}}{{i}}</text><text wx:if="{{j}}" class="warning-text">库存不足!</text></view></view><view class="section"><view class="section-header"><text class="section-title">库存流水</text></view><view class="log-list"><view wx:if="{{k}}" class="empty"><text>暂无库存流水</text></view><block wx:else><view wx:for="{{l}}" wx:for-item="log" wx:key="h" class="log-item"><view class="log-left"><text class="{{['log-type', log.b]}}">{{log.a}}</text><text class="log-reason">{{log.c}}</text></view><view class="log-right"><text class="{{['log-qty', log.f && 'plus']}}">{{log.d}}{{log.e}}</text><text class="log-time">{{log.g}}</text></view></view></block></view></view></view>
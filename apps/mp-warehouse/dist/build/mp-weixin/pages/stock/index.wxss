.page{min-height:100vh;background:#f5f5f5}.search-bar{display:flex;gap:20rpx;padding:20rpx;background:#fff}.search-bar .search-input{flex:1;height:72rpx;background:#f5f5f5;border-radius:36rpx;padding:0 30rpx;font-size:28rpx}.search-bar .filter-btn{height:72rpx;padding:0 30rpx;background:#1e88e5;border-radius:36rpx;display:flex;align-items:center}.search-bar .filter-btn text{font-size:28rpx;color:#fff}.filter-tags{padding:0 20rpx 20rpx;background:#fff;display:flex;gap:16rpx}.filter-tags .tag{padding:12rpx 24rpx;background:#f5f5f5;border-radius:20rpx}.filter-tags .tag text{font-size:24rpx;color:#666}.filter-tags .tag.active{background:#fff3e0}.filter-tags .tag.active text{color:#ff9800}.stock-list{padding:20rpx}.stock-item{display:flex;align-items:center;background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.stock-item .stock-image{width:120rpx;height:120rpx;border-radius:12rpx;background:#f5f5f5}.stock-item .stock-info{flex:1;margin-left:20rpx}.stock-item .stock-info .stock-name{font-size:28rpx;color:#333;font-weight:500;display:block;margin-bottom:16rpx}.stock-item .stock-info .stock-data{display:flex;gap:30rpx}.stock-item .stock-info .data-item{display:flex;flex-direction:column}.stock-item .stock-info .data-item .data-label{font-size:22rpx;color:#999}.stock-item .stock-info .data-item .data-value{font-size:28rpx;color:#333;font-weight:700;margin-top:4rpx}.stock-item .stock-info .data-item .data-value.warning{color:#ff9800}.stock-item .stock-info .data-item .data-value.lock{color:#f44336}.stock-item .arrow{font-size:28rpx;color:#ccc}.empty{padding:100rpx;text-align:center}.empty text{font-size:28rpx;color:#999}.loading{padding:40rpx;text-align:center}.loading text{font-size:26rpx;color:#999}

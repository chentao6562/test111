<view class="page"><view class="form-section"><view class="form-item"><text class="form-label">供应商名称</text><input placeholder="请输入供应商名称" class="form-input" value="{{a}}" bindinput="{{b}}"/></view><view class="form-item"><text class="form-label">备注</text><input placeholder="选填" class="form-input" value="{{c}}" bindinput="{{d}}"/></view></view><view class="goods-section"><view class="section-header"><text class="section-title">入库商品</text><view class="add-btn" bindtap="{{e}}"><text>+ 添加商品</text></view></view><view wx:if="{{f}}" class="empty"><text>请添加入库商品</text></view><view wx:for="{{g}}" wx:for-item="item" wx:key="g" class="goods-item"><view class="goods-header"><text class="goods-name">{{item.a}}</text><text class="remove-btn" bindtap="{{item.b}}">删除</text></view><view class="goods-inputs"><view class="input-group"><text class="input-label">数量</text><input type="number" placeholder="0" class="input" value="{{item.c}}" bindinput="{{item.d}}"/></view><view class="input-group"><text class="input-label">成本价</text><input type="digit" placeholder="0.00" class="input" value="{{item.e}}" bindinput="{{item.f}}"/></view></view></view></view><view wx:if="{{h}}" class="summary-section"><view class="summary-row"><text>商品数量</text><text>{{i}}件</text></view><view class="summary-row total"><text>总金额</text><text class="amount">¥{{j}}</text></view></view><view class="action-bar"><button class="submit-btn" bindtap="{{k}}">提交入库单</button></view><view wx:if="{{l}}" class="picker-modal"><view class="picker-content"><view class="picker-header"><text class="picker-title">选择商品</text><text class="picker-close" bindtap="{{m}}">关闭</text></view><view class="product-list"><view wx:for="{{n}}" wx:for-item="product" wx:key="d" class="product-item" bindtap="{{product.e}}"><image src="{{product.a}}" mode="aspectFill" class="product-image"/><view class="product-info"><text class="product-name">{{product.b}}</text><text class="product-stock">当前库存: {{product.c}}</text></view></view></view></view></view></view>
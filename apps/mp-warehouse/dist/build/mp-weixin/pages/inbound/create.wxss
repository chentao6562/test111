.page{min-height:100vh;background:#f5f5f5;padding-bottom:150rpx}.form-section{background:#fff;padding:20rpx 30rpx;margin-bottom:20rpx}.form-section .form-item{padding:20rpx 0;border-bottom:1rpx solid #f5f5f5}.form-section .form-item:last-child{border-bottom:none}.form-section .form-item .form-label{font-size:28rpx;color:#333;display:block;margin-bottom:16rpx}.form-section .form-item .form-input{height:72rpx;background:#f5f5f5;border-radius:12rpx;padding:0 24rpx;font-size:28rpx}.goods-section{background:#fff;padding:20rpx 30rpx}.goods-section .section-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:20rpx}.goods-section .section-header .section-title{font-size:30rpx;font-weight:700;color:#333}.goods-section .section-header .add-btn{padding:12rpx 24rpx;background:#1e88e5;border-radius:24rpx}.goods-section .section-header .add-btn text{font-size:26rpx;color:#fff}.goods-section .empty{padding:60rpx;text-align:center}.goods-section .empty text{font-size:28rpx;color:#999}.goods-section .goods-item{background:#f9f9f9;border-radius:12rpx;padding:20rpx;margin-bottom:16rpx}.goods-section .goods-item .goods-header{display:flex;justify-content:space-between;margin-bottom:16rpx}.goods-section .goods-item .goods-header .goods-name{font-size:28rpx;color:#333;font-weight:500}.goods-section .goods-item .goods-header .remove-btn{font-size:26rpx;color:#f44336}.goods-section .goods-item .goods-inputs{display:flex;gap:20rpx}.goods-section .goods-item .goods-inputs .input-group{flex:1}.goods-section .goods-item .goods-inputs .input-group .input-label{font-size:24rpx;color:#999;display:block;margin-bottom:8rpx}.goods-section .goods-item .goods-inputs .input-group .input{height:64rpx;background:#fff;border-radius:8rpx;padding:0 16rpx;font-size:28rpx;text-align:center}.summary-section{background:#fff;margin:20rpx 0;padding:20rpx 30rpx}.summary-section .summary-row{display:flex;justify-content:space-between;padding:12rpx 0;font-size:28rpx;color:#666}.summary-section .summary-row.total{border-top:1rpx solid #f5f5f5;padding-top:20rpx;margin-top:10rpx}.summary-section .summary-row.total .amount{font-size:36rpx;font-weight:700;color:#e53734}.action-bar{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx;background:#fff;box-shadow:0 -4rpx 12rpx rgba(0,0,0,.08)}.action-bar .submit-btn{height:96rpx;background:linear-gradient(135deg,#1e88e5,#1565c0);border-radius:48rpx;font-size:32rpx;font-weight:700;color:#fff}.picker-modal{position:fixed;top:0;left:0;right:0;bottom:0;background:rgba(0,0,0,.5);z-index:100;display:flex;align-items:flex-end}.picker-modal .picker-content{width:100%;max-height:70vh;background:#fff;border-radius:32rpx 32rpx 0 0;padding:30rpx}.picker-modal .picker-content .picker-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:20rpx;border-bottom:1rpx solid #f5f5f5}.picker-modal .picker-content .picker-header .picker-title{font-size:32rpx;font-weight:700;color:#333}.picker-modal .picker-content .picker-header .picker-close{font-size:28rpx;color:#999}.picker-modal .picker-content .product-list{max-height:60vh;overflow-y:auto;padding-top:20rpx}.picker-modal .picker-content .product-list .product-item{display:flex;align-items:center;padding:20rpx 0;border-bottom:1rpx solid #f5f5f5}.picker-modal .picker-content .product-list .product-item .product-image{width:100rpx;height:100rpx;border-radius:12rpx;background:#f5f5f5}.picker-modal .picker-content .product-list .product-item .product-info{flex:1;margin-left:20rpx}.picker-modal .picker-content .product-list .product-item .product-info .product-name{font-size:28rpx;color:#333;display:block}.picker-modal .picker-content .product-list .product-item .product-info .product-stock{font-size:24rpx;color:#999;margin-top:8rpx}

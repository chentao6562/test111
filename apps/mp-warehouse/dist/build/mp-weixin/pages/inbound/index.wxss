.page{min-height:100vh;background:#f5f5f5;padding:20rpx}.header-actions{margin-bottom:20rpx}.header-actions .create-btn{height:88rpx;background:linear-gradient(135deg,#1e88e5,#1565c0);border-radius:16rpx;display:flex;align-items:center;justify-content:center}.header-actions .create-btn text{font-size:30rpx;font-weight:700;color:#fff}.list-section .inbound-item{background:#fff;border-radius:16rpx;padding:24rpx;margin-bottom:20rpx}.list-section .inbound-item .item-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:16rpx;border-bottom:1rpx solid #f5f5f5}.list-section .inbound-item .item-header .inbound-no{font-size:28rpx;color:#333;font-weight:500}.list-section .inbound-item .item-header .status{font-size:24rpx;padding:6rpx 16rpx;border-radius:8rpx}.list-section .inbound-item .item-header .status.pending{background:#fff3e0;color:#ff9800}.list-section .inbound-item .item-header .status.completed{background:#e8f5e9;color:#4caf50}.list-section .inbound-item .item-content{padding:16rpx 0}.list-section .inbound-item .item-content .info-row{display:flex;justify-content:space-between;padding:8rpx 0}.list-section .inbound-item .item-content .info-row .label{font-size:26rpx;color:#999}.list-section .inbound-item .item-content .info-row .value{font-size:26rpx;color:#333}.list-section .inbound-item .item-content .info-row .value.amount{color:#e53734;font-weight:700}.list-section .inbound-item .item-footer{display:flex;justify-content:space-between;align-items:center;padding-top:16rpx;border-top:1rpx solid #f5f5f5}.list-section .inbound-item .item-footer .time{font-size:24rpx;color:#999}.list-section .inbound-item .item-footer .action-btn{padding:12rpx 32rpx;background:#1e88e5;border-radius:24rpx}.list-section .inbound-item .item-footer .action-btn text{font-size:26rpx;color:#fff;font-weight:500}.empty{padding:100rpx;text-align:center}.empty text{font-size:28rpx;color:#999}.loading{padding:40rpx;text-align:center}.loading text{font-size:26rpx;color:#999}

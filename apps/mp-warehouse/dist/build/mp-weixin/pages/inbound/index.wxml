<view class="page"><view class="header-actions"><button class="create-btn" bindtap="{{a}}"><text>+ 新建入库</text></button></view><view class="list-section"><view wx:if="{{b}}" class="empty"><text>暂无入库记录</text></view><view wx:for="{{c}}" wx:for-item="item" wx:key="j" class="inbound-item"><view class="item-header"><text class="inbound-no">{{item.a}}</text><text class="{{['status', item.c]}}">{{item.b}}</text></view><view class="item-content"><view class="info-row"><text class="label">供应商</text><text class="value">{{item.d}}</text></view><view class="info-row"><text class="label">商品数量</text><text class="value">{{item.e}}件</text></view><view class="info-row"><text class="label">总金额</text><text class="value amount">¥{{item.f}}</text></view></view><view class="item-footer"><text class="time">{{item.g}}</text><view wx:if="{{item.h}}" class="action-btn" bindtap="{{item.i}}"><text>确认入库</text></view></view></view></view><view wx:if="{{d}}" class="loading"><text>加载中...</text></view></view>
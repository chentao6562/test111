<view class="page"><view class="header"><view class="welcome"><text class="name">{{a}}</text><text class="role">仓库管理员</text></view><view class="date">{{b}}</view></view><view class="stats-section"><view class="stats-grid"><view class="stat-card"><text class="stat-value">{{c}}</text><text class="stat-label">待核销</text></view><view class="stat-card"><text class="stat-value">{{d}}</text><text class="stat-label">待备货</text></view><view class="stat-card warning"><text class="stat-value">{{e}}</text><text class="stat-label">库存预警</text></view><view class="stat-card"><text class="stat-value">{{f}}</text><text class="stat-label">今日入库</text></view></view></view><view class="quick-actions"><view class="section-title">快捷操作</view><view class="action-grid"><view class="action-item" bindtap="{{g}}"><view class="action-icon scan"><text>扫</text></view><text class="action-text">扫码核销</text></view><view class="action-item" bindtap="{{h}}"><view class="action-icon stock"><text>库</text></view><text class="action-text">库存查询</text></view><view class="action-item" bindtap="{{i}}"><view class="action-icon inbound"><text>入</text></view><text class="action-text">入库登记</text></view><view class="action-item" bindtap="{{j}}"><view class="action-icon prepare"><text>备</text></view><text class="action-text">备货任务</text></view></view></view><view class="menu-section"><view class="section-title">功能菜单</view><view class="menu-list"><view class="menu-item" bindtap="{{k}}"><text class="menu-text">入库记录</text><text class="menu-arrow">&gt;</text></view><view class="menu-item" bindtap="{{l}}"><text class="menu-text">个人中心</text><text class="menu-arrow">&gt;</text></view></view></view></view>
.page{min-height:100vh;background:#f5f5f5}.profile-header{background:linear-gradient(135deg,#1e88e5,#1565c0);padding:60rpx 30rpx;display:flex;align-items:center}.profile-header .avatar{width:120rpx;height:120rpx;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center}.profile-header .avatar text{font-size:48rpx;font-weight:700;color:#fff}.profile-header .profile-info{margin-left:24rpx;display:flex;flex-direction:column}.profile-header .profile-info .name{font-size:36rpx;font-weight:700;color:#fff}.profile-header .profile-info .role{font-size:26rpx;color:rgba(255,255,255,.8);margin-top:8rpx}.menu-section{background:#fff;margin:20rpx;border-radius:16rpx;overflow:hidden}.menu-section .menu-item{display:flex;align-items:center;padding:30rpx;border-bottom:1rpx solid #f5f5f5}.menu-section .menu-item:last-child{border-bottom:none}.menu-section .menu-item .menu-icon{width:60rpx;height:60rpx;border-radius:12rpx;display:flex;align-items:center;justify-content:center}.menu-section .menu-item .menu-icon text{font-size:28rpx;font-weight:700;color:#fff}.menu-section .menu-item .menu-icon.home{background:linear-gradient(135deg,#1e88e5,#1565c0)}.menu-section .menu-item .menu-icon.scan{background:linear-gradient(135deg,#4caf50,#388e3c)}.menu-section .menu-item .menu-icon.stock{background:linear-gradient(135deg,#2196f3,#1976d2)}.menu-section .menu-item .menu-icon.inbound{background:linear-gradient(135deg,#ff9800,#f57c00)}.menu-section .menu-item .menu-icon.prepare{background:linear-gradient(135deg,#9c27b0,#7b1fa2)}.menu-section .menu-item .menu-icon.cache{background:linear-gradient(135deg,#607d8b,#455a64)}.menu-section .menu-item .menu-icon.about{background:linear-gradient(135deg,#795548,#5d4037)}.menu-section .menu-item .menu-text{flex:1;font-size:28rpx;color:#333;margin-left:20rpx}.menu-section .menu-item .menu-arrow{font-size:28rpx;color:#ccc}.logout-section{padding:40rpx 30rpx}.logout-section .logout-btn{height:88rpx;background:#fff;border:2rpx solid #f44336;border-radius:44rpx;font-size:30rpx;color:#f44336}.version{text-align:center;padding:30rpx}.version text{font-size:24rpx;color:#999}

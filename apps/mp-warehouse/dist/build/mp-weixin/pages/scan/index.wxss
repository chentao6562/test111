.page{min-height:100vh;background:#f5f5f5;padding:30rpx}.scan-area{background:#fff;border-radius:20rpx;padding:60rpx;display:flex;justify-content:center}.scan-area .camera-box{display:flex;flex-direction:column;align-items:center}.scan-area .scan-icon{width:200rpx;height:200rpx;border-radius:50%;background:linear-gradient(135deg,#4caf50,#388e3c);display:flex;align-items:center;justify-content:center}.scan-area .scan-icon text{font-size:80rpx;font-weight:700;color:#fff}.scan-area .scan-tip{font-size:28rpx;color:#666;margin-top:30rpx}.divider{display:flex;align-items:center;gap:24rpx;margin:40rpx 0}.divider .line{flex:1;height:1rpx;background:#ddd}.divider text{font-size:26rpx;color:#999}.manual-input{background:#fff;border-radius:20rpx;padding:30rpx}.manual-input .input-title{font-size:28rpx;color:#333;font-weight:500;display:block;margin-bottom:20rpx}.manual-input .input-box{display:flex;gap:20rpx}.manual-input .input-box .code-input{flex:1;height:88rpx;background:#f5f5f5;border-radius:12rpx;padding:0 24rpx;font-size:32rpx;letter-spacing:8rpx;text-align:center}.manual-input .input-box .search-btn{width:160rpx;height:88rpx;background:#1e88e5;border-radius:12rpx;font-size:28rpx;font-weight:700;color:#fff;display:flex;align-items:center;justify-content:center}.history-section{margin-top:30rpx}.history-section .section-title{font-size:28rpx;color:#666;display:block;margin-bottom:16rpx}.history-section .history-list{background:#fff;border-radius:16rpx;overflow:hidden}.history-section .history-item{display:flex;justify-content:space-between;align-items:center;padding:24rpx 30rpx;border-bottom:1rpx solid #f5f5f5}.history-section .history-item:last-child{border-bottom:none}.history-section .history-item .code{font-size:32rpx;font-weight:700;color:#1e88e5;letter-spacing:4rpx}.history-section .history-item .time{font-size:24rpx;color:#999}

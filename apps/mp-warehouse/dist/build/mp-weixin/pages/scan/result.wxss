.page{min-height:100vh;background:#f5f5f5;padding-bottom:150rpx}.status-header{background:linear-gradient(135deg,#4caf50,#388e3c);padding:60rpx 30rpx;display:flex;flex-direction:column;align-items:center}.status-header.picked{background:linear-gradient(135deg,#9e9e9e,#757575)}.status-header .status-icon{width:100rpx;height:100rpx;border-radius:50%;background:rgba(255,255,255,.2);display:flex;align-items:center;justify-content:center}.status-header .status-icon text{font-size:48rpx;font-weight:700;color:#fff}.status-header .status-text{font-size:36rpx;font-weight:700;color:#fff;margin-top:20rpx}.status-header .pickup-code{font-size:28rpx;color:rgba(255,255,255,.9);margin-top:12rpx}.order-info{background:#fff;margin:20rpx;border-radius:16rpx;padding:30rpx}.order-info .info-header{display:flex;justify-content:space-between;align-items:center;padding-bottom:20rpx;border-bottom:1rpx solid #f5f5f5}.order-info .info-header .order-no{font-size:26rpx;color:#666}.order-info .info-header .order-time{font-size:24rpx;color:#999}.order-info .customer-info{display:flex;justify-content:space-between;padding-top:20rpx}.order-info .customer-info .label{font-size:28rpx;color:#666}.order-info .customer-info .value{font-size:28rpx;color:#333;font-weight:500}.goods-section{margin:20rpx}.goods-section .section-title{font-size:28rpx;font-weight:700;color:#333;margin-bottom:16rpx}.goods-section .goods-list{background:#fff;border-radius:16rpx;padding:20rpx}.goods-section .goods-item{display:flex;padding:16rpx 0;border-bottom:1rpx solid #f5f5f5}.goods-section .goods-item:last-child{border-bottom:none}.goods-section .goods-image{width:140rpx;height:140rpx;border-radius:12rpx;background:#f5f5f5}.goods-section .goods-info{flex:1;margin-left:20rpx;display:flex;flex-direction:column;justify-content:space-between}.goods-section .goods-name{font-size:28rpx;color:#333}.goods-section .goods-bottom{display:flex;justify-content:space-between}.goods-section .goods-price{font-size:28rpx;color:#e53734;font-weight:700}.goods-section .goods-qty{font-size:26rpx;color:#999}.amount-section{background:#fff;margin:20rpx;border-radius:16rpx;padding:20rpx 30rpx}.amount-section .amount-item{display:flex;justify-content:space-between;padding:16rpx 0;font-size:28rpx;color:#666}.amount-section .amount-item.total{border-top:1rpx solid #f5f5f5;margin-top:10rpx;padding-top:20rpx}.amount-section .amount-item.total .pay-amount{font-size:36rpx;font-weight:700;color:#e53734}.action-bar{position:fixed;bottom:0;left:0;right:0;padding:20rpx 30rpx;background:#fff;box-shadow:0 -4rpx 12rpx rgba(0,0,0,.08)}.action-bar .confirm-btn{height:96rpx;background:linear-gradient(135deg,#4caf50,#388e3c);border-radius:48rpx;font-size:32rpx;font-weight:700;color:#fff}

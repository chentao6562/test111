<view class="page"><view class="scan-area"><view class="camera-box" bindtap="{{a}}"><view class="scan-icon"><text>扫</text></view><text class="scan-tip">点击扫描提货码</text></view></view><view class="divider"><view class="line"></view><text>或</text><view class="line"></view></view><view class="manual-input"><text class="input-title">手动输入提货码</text><view class="input-box"><input type="number" placeholder="请输入6位提货码" maxlength="6" class="code-input" value="{{b}}" bindinput="{{c}}"/><button class="search-btn" bindtap="{{d}}">查询</button></view></view><view wx:if="{{e}}" class="history-section"><text class="section-title">最近核销</text><view class="history-list"><view wx:for="{{f}}" wx:for-item="item" wx:key="c" class="history-item" bindtap="{{item.d}}"><text class="code">{{item.a}}</text><text class="time">{{item.b}}</text></view></view></view></view>
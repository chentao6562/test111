  isPackage    Boolean @default(false) @map("is_package") // 是否套餐商品
  packageId    Int?    @map("package_id") // 套餐ID
  packageName  String? @map("package_name") @db.VarChar(100) // 套餐名称
  packageItems String? @map("package_items") @db.Text // 套餐商品明细JSON快照

  // 【2026-01-26 特价商品】
  isSpecialPrice Boolean @default(false) @map("is_special_price") // 是否特价商品（快照）

  @@index([reservationId])
  @@index([productId])
  @@index([bargainId])
  @@index([packageId])
  @@map("reservation_items")
}

// 赠品档位表

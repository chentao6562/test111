// 拼团活动表
model GroupBuy {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(20)       // 拼团码: GB + 时间戳

  // 发起人信息
  initiatorId     Int       @map("initiator_id")          // 发起人预约ID
  initiatorPhone  String    @map("initiator_phone") @db.VarChar(20)
  initiatorName   String    @map("initiator_name") @db.VarChar(50)

  // 拼团配置
  configId        Int       @map("config_id")
  requiredCount   Int       @default(3) @map("required_count")  // 成团人数
  bonusGiftName   String?   @map("bonus_gift_name") @db.VarChar(200)  // 拼团赠品名称

  // 门店与提货日期
  storeId         Int       @map("store_id")
  pickupDate      DateTime  @map("pickup_date") @db.Date  // 约定提货日期（必须同一天）

  // 【2026-01-21 顺路拼团-区域】
  regionId        Int?      @map("region_id")    // 区域ID（乡镇/街道级）
  regionName      String?   @map("region_name") @db.VarChar(100) // 冗余存储区域全名

  // 状态: FORMING(组队中), FULL(已满员), COMPLETED(已完成), EXPIRED(已过期), CANCELLED(已取消)
  status          String    @default("FORMING") @db.VarChar(20)
  currentCount    Int       @default(1) @map("current_count")  // 当前人数

  expireAt        DateTime  @map("expire_at")             // 过期时间
  completedAt     DateTime? @map("completed_at")          // 全员提货完成时间
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // 关联
  config          GroupBuyConfig @relation(fields: [configId], references: [id])
  store           Warehouse      @relation(fields: [storeId], references: [id])
  members         GroupBuyMember[]
  region          Region?        @relation("GroupBuyRegion", fields: [regionId], references: [id])

  @@index([code])
  @@index([status, expireAt])
  @@index([storeId, status])
  @@index([initiatorPhone])
  @@index([regionId, status])    // 【2026-01-21】区域+状态索引（顺路拼团查询）
  @@map("group_buys")
}

// 拼团成员表
model GroupBuyMember {
  id                  Int       @id @default(autoincrement())
  groupBuyId          Int       @map("group_buy_id")
  reservationId       Int       @unique @map("reservation_id")  // 一个预约只能加入一个拼团

  // 成员信息
  customerPhone       String    @map("customer_phone") @db.VarChar(20)
  customerName        String    @map("customer_name") @db.VarChar(50)

  // 状态: JOINED(已加入), PICKED_UP(已提货), QUIT(已退出)
  status              String    @default("JOINED") @db.VarChar(20)
  joinedAt            DateTime  @default(now()) @map("joined_at")
  pickedUpAt          DateTime? @map("picked_up_at")

  // 拼团赠品
  bonusGiftDelivered  Boolean   @default(false) @map("bonus_gift_delivered")

  // 【2026-01-25 多档位赠品记录】
  memberGiftName      String?   @map("member_gift_name") @db.VarChar(200)  // 团员获得赠品
  leaderGiftName      String?   @map("leader_gift_name") @db.VarChar(200)  // 团长奖励(仅团长有)
  leaderGiftCount     Int?      @map("leader_gift_count")                  // 团长奖励数量

  // 关联
  groupBuy            GroupBuy    @relation(fields: [groupBuyId], references: [id])
  reservation         Reservation @relation(fields: [reservationId], references: [id])

  @@index([groupBuyId])
  @@index([customerPhone])
  @@map("group_buy_members")
}

// ============ 【2026-01-21 限时锁价功能】============

// 锁价配置表
model PriceLockConfig {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)              // 活动名称
  lockHours       Int       @default(24) @map("lock_hours")  // 锁价有效期（小时）
  minAmount       Decimal?  @map("min_amount") @db.Decimal(10, 2)  // 最低金额门槛

  startTime       DateTime? @map("start_time")
  endTime         DateTime? @map("end_time")
  isActive        Boolean   @default(true) @map("is_active")

  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  @@index([isActive, startTime, endTime])
  @@map("price_lock_configs")
}

// 锁价记录表
model PriceLock {
  id                  Int       @id @default(autoincrement())
  code                String    @unique @db.VarChar(20)   // 锁价码: PL + 时间戳

  // 客户信息
  customerPhone       String    @map("customer_phone") @db.VarChar(20)
  customerName        String?   @map("customer_name") @db.VarChar(50)

  // 推销员信息
  salespersonId       Int?      @map("salesperson_id")
  agentId             Int?      @map("agent_id")          // 总代理ID（无推销员时）

  // 锁价商品（JSON）
  lockedItems         String    @map("locked_items") @db.Text  // [{productId, lockedPrice, quantity}]
  totalAmount         Decimal   @map("total_amount") @db.Decimal(10, 2)

  // 状态: ACTIVE(有效), USED(已使用), EXPIRED(已过期)
  status              String    @default("ACTIVE") @db.VarChar(20)

  expireAt            DateTime  @map("expire_at")
  usedAt              DateTime? @map("used_at")
  usedReservationId   Int?      @map("used_reservation_id")

  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([code])
  @@index([customerPhone, status])
  @@index([status, expireAt])
  @@map("price_locks")
}

// ============ 【2026-01-22 交易审计追踪系统】============

// 交易追踪表 - 记录所有资金变动的完整链路
model TransactionTrace {
  id            Int      @id @default(autoincrement())
  traceId       String   @unique @map("trace_id") @db.VarChar(32)  // 唯一追踪ID: TRC + 时间戳 + 随机数

  // 交易类型
  // PROFIT_SETTLE: 利润结算
  // COUPON_ISSUE: 代金券发放
  // COUPON_REDEEM: 代金券核销
  // RECHARGE: 充值
  // WITHDRAW: 提现
  // GIFT_COST: 赠品成本
  // BALANCE_ADJUST: 人工调账
  // REFUND: 退款
  traceType     String   @map("trace_type") @db.VarChar(30)

  // 涉及的推销员
  agentId       Int      @map("agent_id")
  agent         Agent    @relation(fields: [agentId], references: [id])

  // 金额信息
  amount        Decimal  @db.Decimal(10, 2)          // 变动金额（正数增加，负数减少）
  beforeBalance Decimal  @map("before_balance") @db.Decimal(10, 2)  // 变动前余额
  afterBalance  Decimal  @map("after_balance") @db.Decimal(10, 2)   // 变动后余额

  // 关联源头（可追溯到具体业务单据）
  sourceTable   String   @map("source_table") @db.VarChar(50)  // 源表名: reservations/coupons/withdrawals等
  sourceId      Int      @map("source_id")                      // 源记录ID
  sourceNo      String?  @map("source_no") @db.VarChar(50)     // 源单号（如预约号MQ开头）

  // 详细信息（JSON格式，存储计算过程和原始数据）
  details       String?  @db.Text  // JSON: {计算公式, 原始价格, 分配比例等}

  // 操作人信息
  operatorType  String   @map("operator_type") @db.VarChar(20)  // SYSTEM/STAFF/ADMIN/AGENT
  operatorId    Int?     @map("operator_id")                     // 操作人ID
  operatorName  String?  @map("operator_name") @db.VarChar(50)   // 操作人姓名

  // 状态和校验
  status        String   @default("SUCCESS") @db.VarChar(20)    // SUCCESS/FAILED/PENDING/REVERSED
  checksum      String?  @db.VarChar(64)                         // 数据校验和（防篡改）
  reversedBy    Int?     @map("reversed_by")                     // 被哪条记录冲正
  reversesId    Int?     @map("reverses_id")                     // 冲正哪条记录

  remark        String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt])
  @@index([traceType, createdAt])
  @@index([sourceTable, sourceId])
  @@index([traceId])
  @@index([status])
  @@map("transaction_traces")
}

// 余额快照表 - 定期记录推销员余额，用于对账和恢复
model BalanceSnapshot {
  id            Int      @id @default(autoincrement())

  agentId       Int      @map("agent_id")
  agent         Agent    @relation(fields: [agentId], references: [id])

  // 快照时的余额信息
  balance           Decimal  @db.Decimal(10, 2)                 // 当时余额
  totalCommission   Decimal  @map("total_commission") @db.Decimal(10, 2)  // 累计分润
  totalSales        Decimal  @map("total_sales") @db.Decimal(10, 2)       // 个人销售额
  teamSales         Decimal  @map("team_sales") @db.Decimal(10, 2)        // 团队销售额

  // 快照类型
  // DAILY: 每日快照（凌晨2点自动）
  // WEEKLY: 每周快照（周一凌晨）
  // MONTHLY: 每月快照（1号凌晨）
  // MANUAL: 人工触发
  // PRE_OPERATION: 重要操作前快照
  snapshotType  String   @map("snapshot_type") @db.VarChar(20)

  // 关联的交易追踪（如果是操作前快照）
  relatedTraceId String? @map("related_trace_id") @db.VarChar(32)

  // 校验信息
  transactionCount Int   @map("transaction_count")  // 该时间段的交易数量
  expectedBalance  Decimal? @map("expected_balance") @db.Decimal(10, 2)  // 根据流水计算的预期余额
  isConsistent     Boolean  @default(true) @map("is_consistent")         // 余额是否一致
  discrepancy      Decimal? @db.Decimal(10, 2)                           // 差异金额

  remark        String?  @db.VarChar(255)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([agentId, createdAt])
  @@index([snapshotType, createdAt])
  @@index([isConsistent])
  @@map("balance_snapshots")
}

// 对账记录表 - 记录每次对账结果
model ReconciliationLog {
  id            Int      @id @default(autoincrement())

  // 对账范围
  startTime     DateTime @map("start_time")
  endTime       DateTime @map("end_time")

  // 对账类型: DAILY/WEEKLY/MONTHLY/MANUAL
  reconcileType String   @map("reconcile_type") @db.VarChar(20)

  // 对账结果统计
  totalAgents      Int   @map("total_agents")       // 检查的推销员数量
  consistentCount  Int   @map("consistent_count")   // 余额一致数量
  discrepancyCount Int   @map("discrepancy_count")  // 有差异数量

  // 差异详情（JSON数组）
  discrepancies    String? @db.Text  // [{agentId, expected, actual, diff, possibleCause}]

  // 对账执行信息
  executedBy    String   @map("executed_by") @db.VarChar(20)  // SYSTEM/ADMIN
  executorId    Int?     @map("executor_id")
  executionTime Int      @map("execution_time")               // 执行耗时（毫秒）

  status        String   @default("COMPLETED") @db.VarChar(20)  // RUNNING/COMPLETED/FAILED
  errorMessage  String?  @map("error_message") @db.Text

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([reconcileType, createdAt])
  @@index([status])
  @@map("reconciliation_logs")
}

// 异常告警表 - 记录系统检测到的异常
model AuditAlert {
  id            Int      @id @default(autoincrement())

  // 告警类型
  // BALANCE_MISMATCH: 余额不一致
  // DUPLICATE_SETTLE: 重复结算
  // NEGATIVE_BALANCE: 负余额
  // LARGE_TRANSACTION: 大额交易
  // SUSPICIOUS_PATTERN: 可疑模式
  // MISSING_TRACE: 缺失追踪记录
  alertType     String   @map("alert_type") @db.VarChar(30)

  // 严重程度: LOW/MEDIUM/HIGH/CRITICAL
  severity      String   @db.VarChar(10)

  // 涉及的实体
  agentId       Int?     @map("agent_id")
  relatedTable  String?  @map("related_table") @db.VarChar(50)
  relatedId     Int?     @map("related_id")

  // 告警详情
  title         String   @db.VarChar(100)
  description   String   @db.Text
  details       String?  @db.Text  // JSON格式的详细数据

  // 处理状态
  // PENDING: 待处理
  // INVESTIGATING: 调查中
  // RESOLVED: 已解决
  // IGNORED: 已忽略
  // AUTO_FIXED: 自动修复
  status        String   @default("PENDING") @db.VarChar(20)

  // 处理信息
  handledBy     Int?     @map("handled_by")
  handledAt     DateTime? @map("handled_at")
  resolution    String?  @db.Text  // 解决方案描述

  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([alertType, status])
  @@index([severity, status])
  @@index([agentId])
  @@index([createdAt])
  @@map("audit_alerts")
}

// ============ 【2026-01-21 顺路拼团-区域功能】============

// 区域表（呼和浩特市行政区划：区县 → 乡镇/街道）
model Region {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)              // 区域名称
  parentId  Int?     @map("parent_id")            // 父级ID（区县→乡镇）
  level     Int      @default(1) @db.TinyInt      // 级别: 1=区县 2=乡镇/街道
  sortOrder Int      @default(0) @map("sort_order") // 排序
  isActive  Boolean  @default(true) @map("is_active")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // 自关联（树形结构）
  parent    Region?  @relation("RegionTree", fields: [parentId], references: [id])
  children  Region[] @relation("RegionTree")

  // 关联
  reservations Reservation[] @relation("ReservationRegion")
  groupBuys    GroupBuy[]    @relation("GroupBuyRegion")

  @@index([parentId])
  @@index([level, isActive])
  @@map("regions")
}

// ============ 【2026-01-22 砍价活动系统】============

// 砍价活动配置表
model BargainConfig {
  id              Int       @id @default(autoincrement())
  name            String    @db.VarChar(100)              // 活动名称

  // 时间配置
  startTime       DateTime  @map("start_time")            // 活动开始时间
  endTime         DateTime  @map("end_time")              // 活动结束时间
  bargainHours    Int       @default(24) @map("bargain_hours")  // 砍价有效期（小时）

  // 砍价规则
  minBargainCount Int       @default(3) @map("min_bargain_count")   // 最少砍价次数（达到底价需要的最少人数）
  maxBargainCount Int       @default(20) @map("max_bargain_count")  // 最多砍价次数
  newUserBonus    Decimal   @default(2) @map("new_user_bonus") @db.Decimal(5, 2)  // 新用户额外加成倍数

  // 成本承担配置
  // PLATFORM: 平台（总代理）承担全部
  // SHARED: 推销员和平台按比例承担
  // AGENT: 推销员承担全部
  costBearerType  String    @default("PLATFORM") @map("cost_bearer_type") @db.VarChar(20)
  agentBearRatio  Int       @default(0) @map("agent_bear_ratio")  // 推销员承担比例(0-100)

  // 状态
  isActive        Boolean   @default(true) @map("is_active")

  // 【新增】购物车门槛配置
  minCartAmount   Decimal?  @default(0) @map("min_cart_amount") @db.Decimal(10, 2)
  // 采购单最低金额门槛（0=不限制），不含砍价商品本身

  // 【2026-01-25 防反复砍价机制】
  maxTotalPerUser           Int     @default(4) @map("max_total_per_user")           // 每人活动期间最多砍价次数
  requireCompleteBeforeNext Boolean @default(true) @map("require_complete_before_next") // 是否需要核销才能发起下一次
  categoryLimitPerUser      Int     @default(1) @map("category_limit_per_user")       // 每个品类每人限砍次数

  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  items           BargainConfigItem[]
  bargains        Bargain[]
  customerStats   CustomerBargainStats[]

  @@index([isActive, startTime, endTime])
  @@map("bargain_configs")
}

// 砍价商品配置表
model BargainConfigItem {
  id            Int       @id @default(autoincrement())
  configId      Int       @map("config_id")              // 活动ID
  productId     Int       @map("product_id")             // 商品ID

  // 【2026-01-25 品类标识】用于防反复机制
  categoryCode  String?   @map("category_code") @db.VarChar(50)  // 品类标识(如GIFT_SMALL_1/GIFT_SMALL_2)

  // 价格配置
  originalPrice Decimal   @map("original_price") @db.Decimal(10, 2)  // 原价（零售价）
  floorPrice    Decimal   @map("floor_price") @db.Decimal(10, 2)     // 底价（最低可砍到的价格）

  // 【2026-01-25 商品级砍价人数配置】
  minBargainCount Int?    @map("min_bargain_count")  // 商品级最少砍价人数(覆盖活动配置)

  // 库存限制
  bargainStock  Int       @default(0) @map("bargain_stock")  // 砍价专属库存(0=不限，使用商品库存)
  soldCount     Int       @default(0) @map("sold_count")     // 已成功砍价数量

  // 限购
  limitPerUser  Int       @default(1) @map("limit_per_user")  // 每人限购

  sort          Int       @default(0)

  config        BargainConfig @relation(fields: [configId], references: [id], onDelete: Cascade)
  product       Product       @relation(fields: [productId], references: [id])

  @@unique([configId, productId])
  @@index([configId])
  @@map("bargain_config_items")
}

// 砍价活动表（用户发起的砍价）
model Bargain {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(20)       // 砍价码: BG + 时间戳 + 随机数

  // 发起人信息
  initiatorPhone  String    @map("initiator_phone") @db.VarChar(20)
  initiatorName   String?   @map("initiator_name") @db.VarChar(50)

  // 推销员信息（继承自分享链接）
  salespersonId       Int?      @map("salesperson_id")
  salespersonLevel    Int?      @map("salesperson_level") @db.TinyInt
  parentSalespersonId Int?      @map("parent_salesperson_id")
  agentId             Int?      @map("agent_id")          // 总代理ID

  // 活动配置关联
  configId        Int       @map("config_id")
  productId       Int       @map("product_id")

  // 价格信息
  originalPrice   Decimal   @map("original_price") @db.Decimal(10, 2)   // 原价
  floorPrice      Decimal   @map("floor_price") @db.Decimal(10, 2)       // 底价
  currentPrice    Decimal   @map("current_price") @db.Decimal(10, 2)     // 当前价格
  totalCut        Decimal   @default(0) @map("total_cut") @db.Decimal(10, 2)  // 已砍金额

  // 数量
  quantity        Int       @default(1)                    // 购买数量

  // 门店信息
  storeId         Int       @map("store_id")
  pickupDate      DateTime? @map("pickup_date")              // 提货日期

  // 砍价次数统计
  cutCount        Int       @default(0) @map("cut_count")  // 已砍次数

  // 状态: BARGAINING(砍价中), SUCCESS(砍价成功), ORDERED(已下单), EXPIRED(已过期), CANCELLED(已取消)
  status          String    @default("BARGAINING") @db.VarChar(20)

  // 是否达到底价
  reachedFloor    Boolean   @default(false) @map("reached_floor")

  // 关联的预约（砍价成功后创建）
  reservationId   Int?      @unique @map("reservation_id")

  // 成本承担记录
  platformCost    Decimal   @default(0) @map("platform_cost") @db.Decimal(10, 2)  // 平台承担成本
  agentCost       Decimal   @default(0) @map("agent_cost") @db.Decimal(10, 2)     // 推销员承担成本

  expireAt        DateTime  @map("expire_at")
  orderedAt       DateTime? @map("ordered_at")            // 下单时间
  successAt       DateTime? @map("success_at")            // 【2026-01-23 P1-07】砍价成功时间
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // 关联
  config          BargainConfig @relation(fields: [configId], references: [id])
  product         Product       @relation(fields: [productId], references: [id])
  store           Warehouse     @relation(fields: [storeId], references: [id])
  cuts            BargainCut[]

  @@index([code])
  @@index([initiatorPhone])
  @@index([status, expireAt])
  @@index([salespersonId])
  @@index([configId, productId])
  @@map("bargains")
}

// 砍价记录表（每次砍价的详情）
model BargainCut {
  id              Int       @id @default(autoincrement())
  bargainId       Int       @map("bargain_id")

  // 帮砍人信息
  helperPhone     String    @map("helper_phone") @db.VarChar(20)
  helperName      String?   @map("helper_name") @db.VarChar(50)

  // 砍价金额
  cutAmount       Decimal   @map("cut_amount") @db.Decimal(10, 2)

  // 是否新用户（首次在平台帮砍）
  isNewUser       Boolean   @default(false) @map("is_new_user")

  // 砍价后的价格
  priceAfterCut   Decimal   @map("price_after_cut") @db.Decimal(10, 2)

  // 风控信息
  ipAddress       String?   @map("ip_address") @db.VarChar(50)
  deviceId        String?   @map("device_id") @db.VarChar(100)

  createdAt       DateTime  @default(now()) @map("created_at")

  bargain         Bargain   @relation(fields: [bargainId], references: [id], onDelete: Cascade)

  @@unique([bargainId, helperPhone])  // 同一用户只能帮砍一次
  @@index([bargainId])
  @@index([helperPhone])
  @@map("bargain_cuts")
}

// 砍价黑名单（防刷）
model BargainBlacklist {
  id              Int       @id @default(autoincrement())

  // 黑名单类型: PHONE(手机号), IP(IP地址), DEVICE(设备ID)
  type            String    @db.VarChar(20)
  value           String    @db.VarChar(100)

  reason          String?   @db.VarChar(255)

  // 封禁时间范围（null表示永久）
  expireAt        DateTime? @map("expire_at")

  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([type, value])
  @@index([type, value, expireAt])
  @@map("bargain_blacklists")
}

// 【2026-01-25 客户砍价统计表 - 防反复砍价机制】
model CustomerBargainStats {
  id                    Int       @id @default(autoincrement())
  customerPhone         String    @map("customer_phone") @db.VarChar(20)  // 客户手机号
  configId              Int       @map("config_id")                       // 活动配置ID

  // 总次数统计（整个活动期间最多4次）
  totalBargainCount     Int       @default(0) @map("total_bargain_count")     // 总发起砍价次数
  totalCompletedCount   Int       @default(0) @map("total_completed_count")   // 已核销次数

  // 品类砍价记录（JSON格式）
  // 示例: {"GIFT_SMALL_1": {"bargainId": 123, "productId": 1, "status": "ORDERED"}, ...}
  categoryRecords       String?   @map("category_records") @db.Text

  // 当前进行中的砍价（必须核销才能发起下一个）
  currentBargainId      Int?      @map("current_bargain_id")
  currentBargainStatus  String?   @map("current_bargain_status") @db.VarChar(20)

  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  // 关联
  config                BargainConfig @relation(fields: [configId], references: [id])

  @@unique([customerPhone, configId])
  @@index([customerPhone])
  @@map("customer_bargain_stats")
}

// ============ 【2026-01-23 现金大转盘裂变系统】============

// 转盘活动配置表
model SpinWheelConfig {
  id                Int       @id @default(autoincrement())
  name              String    @db.VarChar(100)              // 活动名称

  // 时间配置
  startTime         DateTime  @map("start_time")            // 活动开始时间
  endTime           DateTime  @map("end_time")              // 活动结束时间

  // 奖池配置（JSON格式）
  // 示例: [{"name": "0.01元", "amount": 0.01, "weight": 50}, ...]
  prizePool         String    @map("prize_pool") @db.Text

  // 兑换门槛
  redeemThreshold   Decimal   @default(100) @map("redeem_threshold") @db.Decimal(10, 2)  // 兑换门槛（默认100元）

  // 抽奖次数配置
  freeSpinCount     Int       @default(3) @map("free_spin_count")     // 每日免费抽奖次数
  shareSpinCount    Int       @default(2) @map("share_spin_count")    // 分享可获得次数
  maxDailyHelp      Int       @default(10) @map("max_daily_help")     // 每日最多被助力次数

  // 助力金额配置
  newUserHelpMin    Decimal   @default(3) @map("new_user_help_min") @db.Decimal(5, 2)    // 新用户助力最小金额
  newUserHelpMax    Decimal   @default(5) @map("new_user_help_max") @db.Decimal(5, 2)    // 新用户助力最大金额
  oldUserHelpMin    Decimal   @default(0.01) @map("old_user_help_min") @db.Decimal(5, 2) // 老用户助力最小金额
  oldUserHelpMax    Decimal   @default(0.5) @map("old_user_help_max") @db.Decimal(5, 2)  // 老用户助力最大金额

  // 碎片过期配置
  fragmentExpireDays Int      @default(7) @map("fragment_expire_days") // 碎片过期天数（0=不过期）

  // 状态
  isActive          Boolean   @default(true) @map("is_active")

  createdBy         Int       @map("created_by")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  participations    SpinWheelParticipation[]
  records           SpinWheelRecord[]
  helps             SpinWheelHelp[]
  redeems           SpinWheelRedeem[]

  @@index([isActive, startTime, endTime])
  @@map("spin_wheel_configs")
}

// 用户参与记录表（核心）
model SpinWheelParticipation {
  id                Int       @id @default(autoincrement())
  code              String    @unique @db.VarChar(20)       // 参与码: SW + 时间戳 + 随机数

  configId          Int       @map("config_id")             // 活动ID
  phone             String    @db.VarChar(20)               // 用户手机号
  name              String?   @db.VarChar(50)               // 用户姓名

  // 金额统计
  totalAmount       Decimal   @default(0) @map("total_amount") @db.Decimal(10, 2)     // 累计碎片金额
  redeemedAmount    Decimal   @default(0) @map("redeemed_amount") @db.Decimal(10, 2)  // 已兑换金额
  expiredAmount     Decimal   @default(0) @map("expired_amount") @db.Decimal(10, 2)   // 已过期金额

  // 今日统计（每日重置）
  todaySpinCount    Int       @default(0) @map("today_spin_count")   // 今日抽奖次数
  todayHelpCount    Int       @default(0) @map("today_help_count")   // 今日被助力次数
  todayDate         DateTime? @map("today_date") @db.Date            // 今日日期（用于判断是否需要重置）

  // 抽奖次数
  spinCount         Int       @default(0) @map("spin_count")         // 总抽奖次数
  remainingSpins    Int       @default(0) @map("remaining_spins")    // 剩余抽奖次数
  shareBonus        Boolean   @default(false) @map("share_bonus")    // 今日是否已获得分享奖励

  // 推销员信息（继承自分享链接）
  salespersonId     Int?      @map("salesperson_id")

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  config            SpinWheelConfig @relation(fields: [configId], references: [id])
  records           SpinWheelRecord[]
  helpsReceived     SpinWheelHelp[] @relation("HelpReceiver")
  redeems           SpinWheelRedeem[]

  @@unique([configId, phone])
  @@index([code])
  @@index([phone])
  @@index([configId])
  @@index([salespersonId])
  @@map("spin_wheel_participations")
}

// 抽奖记录表
model SpinWheelRecord {
  id                Int       @id @default(autoincrement())
  participationId   Int       @map("participation_id")
  configId          Int       @map("config_id")

  // 奖品信息
  prizeName         String    @map("prize_name") @db.VarChar(50)      // 奖品名称
  prizeAmount       Decimal   @map("prize_amount") @db.Decimal(10, 2) // 奖品金额

  // 抽奖类型: FREE(免费抽奖), SHARE(分享获得), HELP(助力获得)
  spinType          String    @map("spin_type") @db.VarChar(20)

  // 是否过期
  isExpired         Boolean   @default(false) @map("is_expired")
  expireAt          DateTime? @map("expire_at")                        // 过期时间

  createdAt         DateTime  @default(now()) @map("created_at")

  participation     SpinWheelParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  config            SpinWheelConfig @relation(fields: [configId], references: [id])

  @@index([participationId])
  @@index([configId])
  @@index([isExpired, expireAt])
  @@map("spin_wheel_records")
}

// 助力记录表
model SpinWheelHelp {
  id                Int       @id @default(autoincrement())
  participationId   Int       @map("participation_id")      // 被助力的参与记录ID
  configId          Int       @map("config_id")

  // 助力人信息
  helperPhone       String    @map("helper_phone") @db.VarChar(20)
  helperName        String?   @map("helper_name") @db.VarChar(50)

  // 助力金额
  helpAmount        Decimal   @map("help_amount") @db.Decimal(10, 2)

  // 是否新用户（首次在平台助力）
  isNewUser         Boolean   @default(false) @map("is_new_user")

  // 风控信息
  ipAddress         String?   @map("ip_address") @db.VarChar(50)
  deviceId          String?   @map("device_id") @db.VarChar(100)

  createdAt         DateTime  @default(now()) @map("created_at")

  participation     SpinWheelParticipation @relation("HelpReceiver", fields: [participationId], references: [id], onDelete: Cascade)
  config            SpinWheelConfig @relation(fields: [configId], references: [id])

  @@unique([participationId, helperPhone])  // 同一用户只能助力一次
  @@index([participationId])
  @@index([helperPhone])
  @@index([configId])
  @@map("spin_wheel_helps")
}

// 兑换记录表
model SpinWheelRedeem {
  id                Int       @id @default(autoincrement())
  participationId   Int       @map("participation_id")
  configId          Int       @map("config_id")

  // 兑换金额
  redeemAmount      Decimal   @map("redeem_amount") @db.Decimal(10, 2)

  // 关联的代金券
  couponId          Int?      @map("coupon_id")

  // 状态: PENDING(处理中), SUCCESS(成功), FAILED(失败)
  status            String    @default("PENDING") @db.VarChar(20)
  failReason        String?   @map("fail_reason") @db.VarChar(255)

  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  participation     SpinWheelParticipation @relation(fields: [participationId], references: [id], onDelete: Cascade)
  config            SpinWheelConfig @relation(fields: [configId], references: [id])

  @@index([participationId])
  @@index([configId])
  @@index([status])
  @@map("spin_wheel_redeems")
}

// 转盘黑名单（防刷）
model SpinWheelBlacklist {
  id              Int       @id @default(autoincrement())

  // 黑名单类型: PHONE(手机号), IP(IP地址), DEVICE(设备ID)
  type            String    @db.VarChar(20)
  value           String    @db.VarChar(100)

  reason          String?   @db.VarChar(255)

  // 封禁时间范围（null表示永久）
  expireAt        DateTime? @map("expire_at")

  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")

  @@unique([type, value])
  @@index([type, value, expireAt])
  @@map("spin_wheel_blacklists")
}

// ============ 【2026-01-25 套餐系统】============

// 套餐配置表
model ProductPackage {
  id              Int       @id @default(autoincrement())
  code            String    @unique @db.VarChar(20)  // 套餐编码: PKG001
  name            String    @db.VarChar(100)         // 套餐名称: 欢乐体验装

  // 定位: ENTRY(引流款)/HOT(爆款)/PROFIT(利润款)
  positioning     String    @db.VarChar(20)

  description     String?   @db.Text                 // 套餐描述
  images          String    @db.Text                 // 套餐图片(JSON数组)

  // 四级价格体系（与Product表一致）
  costPrice         Decimal   @map("cost_price") @db.Decimal(10, 2)       // 成本价(商品成本合计)
  supplyPrice       Decimal   @map("supply_price") @db.Decimal(10, 2)     // 供货价(给一级推销员)
  suggestedPrice    Decimal?  @map("suggested_price") @db.Decimal(10, 2)  // 建议零售价
  masterRetailPrice Decimal   @map("master_retail_price") @db.Decimal(10, 2) // 总代理零售价(默认展示价)

  // 毛利率（前端展示用，由成本和零售价计算）
  grossMargin     Decimal?  @map("gross_margin") @db.Decimal(5, 2)

  // 适用场景标签(JSON数组): ["入门尝鲜", "预算有限"]
  sceneTags       String?   @map("scene_tags") @db.VarChar(500)
  targetAudience  String?   @map("target_audience") @db.VarChar(100)  // 目标人群

  // 库存策略: COMPONENT(按组成商品计算), INDEPENDENT(独立库存)
  stockStrategy   String    @default("COMPONENT") @map("stock_strategy") @db.VarChar(20)
  independentStock Int      @default(0) @map("independent_stock")  // 独立库存数量

  // 排序和状态
  sort            Int       @default(0)
  status          String    @default("ACTIVE") @db.VarChar(20)  // ACTIVE/INACTIVE

  createdBy       Int       @map("created_by")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // 关联
  items           PackageItem[]
  agentPrices     PackageAgentPrice[]

  @@index([status, sort])
  @@index([positioning])
  @@map("product_packages")
}

// 套餐商品明细表
model PackageItem {
  id              Int       @id @default(autoincrement())
  packageId       Int       @map("package_id")
  productId       Int       @map("product_id")
  quantity        Int       @default(1)              // 商品数量

  // 价格快照(创建时冻结，用于计算套餐成本)
  snapshotCostPrice   Decimal? @map("snapshot_cost_price") @db.Decimal(10, 2)
  snapshotSupplyPrice Decimal? @map("snapshot_supply_price") @db.Decimal(10, 2)
  snapshotRetailPrice Decimal? @map("snapshot_retail_price") @db.Decimal(10, 2)

  sort            Int       @default(0)

  package         ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  product         Product @relation(fields: [productId], references: [id])

  @@unique([packageId, productId])
  @@index([packageId])
  @@index([productId])
  @@map("package_items")
}

// 套餐推销员定价表
model PackageAgentPrice {
  id              Int       @id @default(autoincrement())
  packageId       Int       @map("package_id")
  agentId         Int       @map("agent_id")

  retailPrice     Decimal?  @map("retail_price") @db.Decimal(10, 2)   // 我的零售价
  subPrice        Decimal?  @map("sub_price") @db.Decimal(10, 2)      // 给下级的价格(一级专用)

  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  package         ProductPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@unique([packageId, agentId])
  @@index([agentId])
  @@map("package_agent_prices")
}

// ============ 【2026-01-28 BGM背景音乐】============

// BGM音乐表
model BgmMusic {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)  // 音乐名称
  url       String   @db.VarChar(500)  // 文件URL
  duration  Int?     // 时长（秒）
  isActive  Boolean  @default(true) @map("is_active")  // 是否启用
  sortOrder Int      @default(0) @map("sort_order")    // 排序
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("bgm_musics")
}

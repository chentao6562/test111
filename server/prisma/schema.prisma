  memberGiftsJson String?   @map("member_gifts_json") @db.Text     // 多档位团员赠品配置JSON
  leaderGiftName  String?   @map("leader_gift_name") @db.VarChar(200)  // 团长奖励名称
  leaderGiftCost  Decimal?  @map("leader_gift_cost") @db.Decimal(10, 2) // 团长奖励成本

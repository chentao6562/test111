  snapshotSupplyPrice Decimal? @db.Decimal(10, 2) // 供货价
  snapshotLevel1Price Decimal? @db.Decimal(10, 2) // 一级给二级价
  snapshotRetailPrice Decimal? @db.Decimal(10, 2) // 零售价

  // 【2026-01-17 备货环节】
  prepared Boolean @default(false) // 是否已备货

  // 【2026-01-20 秒杀系统】
  isFlashSale     Boolean @default(false) @map("is_flash_sale") // 是否秒杀商品
  flashSaleItemId Int?    @map("flash_sale_item_id") // 秒杀商品项ID

  // 【2026-01-23 砍价系统】
  isBargain  Boolean @default(false) @map("is_bargain") // 是否砍价商品
  bargainId  Int?    @map("bargain_id") // 砍价记录ID


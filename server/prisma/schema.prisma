// ============ 【2026-01-16 预约模式】预约系统 ============

// 预约单
model Reservation {
  id            Int    @id @default(autoincrement())
  reservationNo String @unique @db.VarChar(32) // 预约号 MQ2026011700001

  // 客户信息
  customerName  String   @db.VarChar(50) // 提货人姓名
  customerPhone String   @db.VarChar(20) // 提货人手机号
  pickupDate    DateTime @db.Date // 预约提货日期

  // 归属信息
  salespersonId       Int? // 推销员ID
  salespersonLevel    Int? @db.TinyInt // 推销员级别 1=一级 2=二级
  parentSalespersonId Int? // 上级推销员ID（一级）
  agentId             Int? // 总代理ID
  storeId             Int // 门店ID

  // 金额
  totalAmount Decimal @db.Decimal(10, 2) // 商品总价（到店应付）

  // 赠品
  giftTierId    Int? // 赠品档位ID
  giftName      String? @db.VarChar(200) // 赠品名称
  giftDelivered Boolean @default(false) // 赠品是否已发放

  // 状态：0=待确认 1=确认中 2=已确认 3=已完成 4=已取消 5=已过期 6=确认失败
  status Int @default(0) @db.TinyInt

  // 电话确认
  callCount   Int       @default(0) @db.TinyInt // 拨打次数
  lastCallAt  DateTime? // 最后拨打时间
  confirmedAt DateTime? // 确认时间
  confirmedBy Int? // 确认人

  // 核销
  completedAt   DateTime? // 完成时间（提货时间）
  completedBy   Int? // 核销人
  paymentMethod String?   @db.VarChar(20) // 支付方式：cash/wechat/alipay

  // 【2026-01-17 备货环节】
  staffId    Int? // 负责备货的员工ID
  pickupCode String?   @db.VarChar(20) // 提货码（8位数字）
  preparedAt DateTime? // 备货完成时间

  // 【2026-01-17 超时分配优化】
  assignedStaffId Int?       // 分配的员工ID（超时自动分配用）
  assignedAt      DateTime?  // 分配时间

  // 结算
  settled   Boolean   @default(false) // 是否已结算
  settledAt DateTime? // 结算时间

  // 利润分配
  masterProfit Decimal @default(0) @db.Decimal(10, 2) // 总代理利润
  level1Profit Decimal @default(0) @db.Decimal(10, 2) // 一级推销员利润
  level2Profit Decimal @default(0) @db.Decimal(10, 2) // 二级推销员利润

  // 风控
  customerRiskLevel Int @default(0) @db.TinyInt // 客户风险等级

  // 【2026-01-20 秒杀系统】
  hasFlashSaleItems   Boolean @default(false) @map("has_flash_sale_items") // 是否包含秒杀商品
  flashSaleActivityId Int?    @map("flash_sale_activity_id") // 秒杀活动ID

  // 【2026-01-21 顺路拼团-区域】
  regionId   Int?    @map("region_id")    // 客户所在区域ID（乡镇/街道级）
  regionName String? @map("region_name") @db.VarChar(100) // 冗余存储区域全名（如"赛罕区/大学西路街道"）

  expireAt  DateTime? // 预约截止时间（确认后3天）
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  // 关联
  items          ReservationItem[]
  store          Warehouse              @relation(fields: [storeId], references: [id])
  prepareIssues  PrepareIssue[]         // 【2026-01-17】备货问题记录
  audits         ReservationAudit[]     // 【2026-01-17】操作审计日志
  groupBuyMember GroupBuyMember?        // 【2026-01-21】拼团成员关联
  region         Region?                @relation("ReservationRegion", fields: [regionId], references: [id]) // 【2026-01-21】区域

  // 【2026-01-16 索引优化】提升查询性能
  @@index([salespersonId])
  @@index([status])
  @@index([storeId])
  @@index([customerPhone])
  @@index([pickupDate])
  @@index([storeId, status])                    // 门店待确认列表
  @@index([storeId, status, pickupDate])        // 门店预约筛选
  @@index([salespersonId, status])              // 推销员预约列表
  @@index([customerPhone, pickupDate])          // 客户预约查询
  @@index([status, createdAt])                  // 状态+时间排序
  @@index([status, expireAt])                   // 过期检查
  @@index([pickupCode, storeId, status])        // 【2026-01-17】提货码验证
  @@index([regionId])                           // 【2026-01-21】区域索引
  @@map("reservations")
}

// 预约商品明细
model ReservationItem {

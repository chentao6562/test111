// Prisma Schema for 蒙庆烟花代理商订货系统
// 数据库: MySQL 8.0 (阿里云RDS)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============ 仓库相关 ============

// 仓库/提货点
model Warehouse {
  id   Int    @id @default(autoincrement())
  name String @db.VarChar(100) // 仓库名称
  code String @unique @db.VarChar(20) // 仓库编码 WH001

  // 地址信息
  province String  @db.VarChar(50) // 省份
  city     String  @db.VarChar(50) // 城市
  district String? @db.VarChar(50) // 区县
  address  String  @db.VarChar(255) // 详细地址

  // 经纬度（用于地图展示和距离计算）
  latitude  Decimal? @db.Decimal(10, 6) // 纬度
  longitude Decimal? @db.Decimal(10, 6) // 经度

  // 联系信息
  contactName  String? @db.VarChar(50) // 联系人
  contactPhone String  @db.VarChar(20) // 联系电话

  // 营业信息
  businessHours String? @db.VarChar(100) // 营业时间，如"08:00-18:00"

  // 配置
  isDefault Boolean @default(false) // 是否默认仓库

  // 状态: ACTIVE(正常), INACTIVE(停用)
  status String @default("ACTIVE") @db.VarChar(20)

  sort Int @default(0) // 排序（越小越靠前）

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  staff        SystemUser[] // 归属此仓库的员工
  orders       Order[] // 此仓库的订单
  reservations Reservation[] // 【2026-01-16】预约单
  groupBuys    GroupBuy[]    // 【2026-01-21】拼团活动
  bargains     Bargain[]     // 【2026-01-22】砍价活动

  @@map("warehouses")
}

// ============ 用户相关 ============

// 代理商/推销员（Agent）
// 【2026-01-16 推广体系升级】type含义变更：LEVEL1=一级推销员, LEVEL2=二级推销员, WHOLESALE=批发商(兼容)
model Agent {
  id       Int     @id @default(autoincrement())
  phone    String  @unique @db.VarChar(20)
  password String? @db.VarChar(255)
  name     String  @db.VarChar(50)
  avatar   String? @db.VarChar(500)

  // 代理商类型: LEVEL1(一级推销员), LEVEL2(二级推销员), LEVEL3(三级-兼容), WHOLESALE(批发商)
  type String @default("WHOLESALE") @db.VarChar(20)

  // 状态: PENDING(待审核), ACTIVE(正常), DISABLED(禁用)
  status String @default("ACTIVE") @db.VarChar(20)

  // 上级代理商
  parentId Int?
  parent   Agent?  @relation("AgentHierarchy", fields: [parentId], references: [id])
  children Agent[] @relation("AgentHierarchy")

  // 邀请码（唯一）
  inviteCode String @unique @db.VarChar(10)

  // 财务信息
  balance         Decimal @default(0) @db.Decimal(10, 2) // 可提现余额
  totalCommission Decimal @default(0) @db.Decimal(10, 2) // 累计分润（兼容旧字段）

  // 【2026-01-27】分润方式统一为PRICE_DIFF(进货差价/零售价-代理价)，移除RATE比例模式
  commissionMethod String @default("PRICE_DIFF") @db.VarChar(20)

  // 【2026-01-16 推广体系升级】新增字段
  isMaster          Boolean   @default(false) // 是否总代理
  totalSales        Decimal   @default(0) @db.Decimal(12, 2) // 个人累计销售额
  totalOrderCount   Int       @default(0) // 累计订单数
  teamSales         Decimal   @default(0) @db.Decimal(12, 2) // 团队累计销售额（一级专用）
  validInviteCount  Int       @default(0) // 有效邀请人数（已激活的下级数）
  currentRewardTier Int       @default(0) // 当前已达团队奖励阶梯
  isActivated       Boolean   @default(false) // 是否已激活（累计成交≥激活门槛）
  activatedAt       DateTime? // 激活时间

  // 【2026-01-17 团队奖励月度统计】新增字段
  monthlyTeamSales  Decimal   @default(0) @db.Decimal(12, 2) // 当月团队销售额
  lastRewardMonth   String?   @db.VarChar(7) // 上次发放团队奖励的月份(YYYY-MM)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关联
  orders              Order[]
  commissions         Commission[]
  withdrawals         Withdrawal[]
  rechargeRequests    RechargeRequest[]
  fundFlows           FundFlow[]
  lockStockRequests   LockStockRequest[]
  cartItems           CartItem[]
  agentPrices         AgentPrice[] // 推销员定价
  rewardRecords       RewardRecord[] // 奖励记录
  upgradeApplications UpgradeApplication[] // 升级申请
  // 【2026-01-18 春节营销】
  coupons             Coupon[]       // 代金券
  agentActivity       AgentActivity? // 活动追踪
  shareRecords        ShareRecord[]  // 发圈记录
  weeklyStats         WeeklyStats[]  // 周统计
  // 【2026-01-22 审计追踪】
  transactionTraces   TransactionTrace[]  // 交易追踪记录
  balanceSnapshots    BalanceSnapshot[]   // 余额快照

  @@map("agents")
}

// 系统用户（管理员、库管、货管）
model SystemUser {
  id       Int     @id @default(autoincrement())
  username String  @unique @db.VarChar(50)
  password String  @db.VarChar(255)
  name     String  @db.VarChar(50)
  phone    String? @db.VarChar(20)

  // 角色: ADMIN(管理员), WAREHOUSE(库管), LOGISTICS(货管)
  role String @db.VarChar(20)

  // 状态: ACTIVE(正常), DISABLED(禁用)
  status String @default("ACTIVE") @db.VarChar(20)

  // 【2026-01-13 多仓库支持】所属仓库（库管必填，货管可选）
  warehouseId Int?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // 登录失败计数（用于锁定）
  loginFailCount Int       @default(0)
  lockedUntil    DateTime?

  // 【2026-01-09 业务优化】货管/骑手扩展信息（role=LOGISTICS时使用）
  realName     String? @db.VarChar(50) // 真实姓名
  idCardNo     String? @db.VarChar(18) // 身份证号
  vehicleType  String? @db.VarChar(20) // 车辆类型
  vehiclePlate String? @db.VarChar(20) // 车牌号
  serviceArea  String? @db.VarChar(100) // 服务区域
  isAvailable  Boolean @default(true) // 是否在线接单

  // 【2026-01-10】员工财务信息
  balance     Decimal @default(0) @db.Decimal(10, 2) // 可提现余额
  totalIncome Decimal @default(0) @db.Decimal(10, 2) // 累计收入

  // 收款信息
  bankName    String? @db.VarChar(50) // 银行名称
  bankAccount String? @db.VarChar(50) // 银行账号
  accountName String? @db.VarChar(50) // 账户姓名（开户人）
  alipay      String? @db.VarChar(50) // 支付宝账号
  wechat      String? @db.VarChar(50) // 微信号

  // 关联的移库任务
  transferTasks TransferTask[]

  // 关联的配货订单（库管角色使用）
  warehouseOrders Order[] @relation("WarehouseOrders")

  // 【已废弃 2026-01-16】移库打包关联已删除

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([warehouseId])
  @@map("system_users")
}

// 短信验证码
model SmsCode {
  id    Int    @id @default(autoincrement())
  phone String @db.VarChar(20)
  code  String @db.VarChar(10)

  // 类型: LOGIN(登录), REGISTER(注册), RESET_PASSWORD(重置密码)
  type String @db.VarChar(20)

  expiredAt DateTime
  used      Boolean  @default(false)
  attempts  Int      @default(0) // 【2026-01-17】验证尝试次数，超过5次自动失效
  createdAt DateTime @default(now())

  @@index([phone, type])
  @@map("sms_codes")
}

// ============ 商品相关 ============

// 商品分类
model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50)
  icon      String?  @db.VarChar(500)
  sort      Int      @default(0)
  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]

  @@map("categories")
}

// 商品
model Product {
  id          Int     @id @default(autoincrement())
  name        String  @db.VarChar(100)
  description String? @db.Text

  // 商品编码/条形码（用于扫码识别）
  barcode String? @unique @db.VarChar(50) // 条形码
  sku     String? @db.VarChar(50) // SKU编码

  // 图片（JSON数组）
  images String @db.Text

  // 价格（三级价格体系 - 兼容旧模式）
  retailPrice    Decimal  @db.Decimal(10, 2) // 零售价
  agentPrice     Decimal  @db.Decimal(10, 2) // 代理价
  wholesalePrice Decimal  @db.Decimal(10, 2) // 批发价
  costPrice      Decimal? @db.Decimal(10, 2) // 成本价（总代理进货价）

  // 【2026-01-16 推广体系升级】新增价格字段
  supplyPrice       Decimal? @db.Decimal(10, 2) // 供货价（给一级推销员的拿货价）
  suggestedPrice    Decimal? @db.Decimal(10, 2) // 建议零售价
  minRetailPrice    Decimal? @db.Decimal(10, 2) // 最低零售价（强制约束）
  masterRetailPrice Decimal? @db.Decimal(10, 2) // 总代理零售价（默认页面价格）

  // 库存
  stock     Int @default(0) // 可用库存
  lockStock Int @default(0) // 锁定库存
  minStock  Int @default(0) // 最低库存预警

  // 单位
  unit String @default("个") @db.VarChar(20)  // 销售单位（最小单位）

  // 【2026-01-17 新增】进货单位换算
  purchaseUnit     String @default("件") @db.VarChar(20)  // 进货单位（箱/件）
  unitConversion   Int    @default(1)                      // 换算比例：1进货单位=N销售单位

  // 分类
  categoryId Int
  category   Category @relation(fields: [categoryId], references: [id])

  // 规格（JSON）
  specs String? @db.Text

  // 销量
  salesCount Int @default(0)

  // 【2026-01-18 AI营销文案】
  slogan           String?   @db.VarChar(100) // AI生成的一句话卖点
  sellingPoints    String?   @db.Text // AI生成的结构化卖点（JSON数组）
  usageScenes      String?   @db.VarChar(500) // AI生成的适用场景（JSON数组）
  aiCopyUpdatedAt  DateTime? // AI内容最后更新时间

  // 【2026-01-23 商品视频】
  videoUrl       String?  @db.VarChar(500)   // 视频URL
  videoThumbnail String?  @db.VarChar(500)   // 视频封面图URL
  videoDuration  Int?                         // 视频时长（秒）

  // 【2026-01-26 特价商品】不参与任何营销活动（砍价/秒杀/锁价/拼团/赠品/代金券）
  isSpecialPrice Boolean @default(false) @map("is_special_price")

  // 状态: ACTIVE(上架), INACTIVE(下架)
  status String @default("ACTIVE") @db.VarChar(20)

  // 【已废弃 2026-01-16】移库字段已删除，改为预约模式

  sort      Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems        OrderItem[]
  stockLogs         StockLog[]
  lockStockRequests LockStockRequest[]
  cartItems         CartItem[]
  h5Recommends      H5RecommendProduct[]
  recommends        RecommendProduct[]
  agentPrices       AgentPrice[] // 推销员定价
  flashSaleItems    FlashSaleItem[] // 秒杀活动商品
  bargainConfigItems BargainConfigItem[] // 【2026-01-22】砍价商品配置
  bargains          Bargain[] // 【2026-01-22】砍价活动
  packageItems      PackageItem[] // 【2026-01-25】套餐商品

  @@index([categoryId])
  @@index([barcode])
  @@map("products")
}

// ============ 购物车相关 ============

// 购物车（订货单）
model CartItem {
  id Int @id @default(autoincrement())

  // 代理商
  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id])

  // 商品
  productId Int
  product   Product @relation(fields: [productId], references: [id])

  // 数量
  quantity Int @default(1)

  // 选中状态（结算时用）
  selected Boolean @default(true)

  // 【新增】砍价关联
  bargainId     Int?      @map("bargain_id")  // 关联的砍价记录ID
  isBargainItem Boolean   @default(false) @map("is_bargain_item")  // 是否砍价商品
  bargainPrice  Decimal?  @map("bargain_price") @db.Decimal(10, 2)  // 砍价后的价格

  // 【2026-01-25 套餐系统】
  isPackageItem Boolean   @default(false) @map("is_package_item")  // 是否套餐商品
  packageId     Int?      @map("package_id")  // 套餐ID
  packagePrice  Decimal?  @map("package_price") @db.Decimal(10, 2)  // 套餐价格

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([agentId, productId, bargainId, packageId]) // 同一代理商同一商品（区分砍价/套餐/普通）
  @@index([agentId])
  @@index([bargainId])
  @@index([packageId])
  @@map("cart_items")
}

// ============ 订单相关 ============

// 订单
model Order {
  id      Int    @id @default(autoincrement())
  orderNo String @unique @db.VarChar(30)

  // 代理商
  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id])

  // 金额
  totalAmount Decimal @db.Decimal(10, 2) // 订单总额
  paidAmount  Decimal @default(0) @db.Decimal(10, 2) // 已付金额
  lockFee     Decimal @default(0) @db.Decimal(10, 2) // 锁货费

  // 状态
  // pending_confirm(待确认), pending_payment(待付款), pending_accept(待接单), preparing(备货中)
  // pending_lock_fee(待付锁货费), pending_transfer(待移库), transferring(移库中)
  // pending_pickup(待提货), completed(已完成), cancelled(已取消)
  status String @default("pending_confirm") @db.VarChar(30)

  // 订单确认相关（新增）
  needConfirm   Boolean   @default(true) // 是否需要确认（一级代理商和批发商不需要）
  confirmerId   Int? // 确认人ID（一级代理商）
  confirmedAt   DateTime? // 确认时间
  confirmRemark String?   @db.VarChar(255) // 确认备注

  // 联系信息
  contactName  String @db.VarChar(50)
  contactPhone String @db.VarChar(20)

  // 提货信息
  pickupCode         String?   @db.VarChar(10) // 提货码（客户提货用）
  transferCode       String?   @db.VarChar(10) // 货管移库码（锁货模式：库管→货管交接用）
  pickupTime         DateTime? // 预约提货时间
  expectedPickupDate String?   @db.VarChar(20) // 预计提货日期 (YYYY-MM-DD)
  pickedAt           DateTime? // 实际提货时间

  // 支付状态（新增）
  depositAmount Decimal? @db.Decimal(10, 2) // 定金金额
  depositPaid   Boolean  @default(false) // 是否已付定金
  fullPaid      Boolean  @default(false) // 是否已付全款

  // 核销时间追踪（新增）
  warehouseVerifiedAt DateTime? // 库管核销时间（自提完成/锁货交接货管）
  warehouseStaffId    Int? // 配货库管ID
  warehouseStaff      SystemUser? @relation("WarehouseOrders", fields: [warehouseStaffId], references: [id])
  logisticsVerifiedAt DateTime? // 货管核销时间（锁货模式交付客户）

  // 【已废弃 2026-01-16】移库模式相关字段已删除，改为预约模式
  // needTransfer, transferFee, transferFeeConfirmed 等字段已移除
  // deliveryName, deliveryPhone, deliveryAddress, deliveryRemark 已移除
  // bundleId 已移除

  // 备注
  remark      String? @db.Text
  adminRemark String? @db.Text

  // 【2026-01-13 多仓库支持】提货仓库
  warehouseId Int? // 提货仓库ID（自提订单为选择的仓库，移库订单为默认仓库）
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])

  // 【2026-01-16 推广体系升级】订单来源与利润分配
  orderSource   Int  @default(0) // 订单来源: 0=总代理/默认页面 1=一级推销员 2=二级推销员
  sourceAgentId Int? // 来源推销员ID（下单时的推销员）

  // 价格快照（用于利润计算）
  snapshotCostPrice   Decimal? @db.Decimal(10, 2) // 快照：成本价
  snapshotSupplyPrice Decimal? @db.Decimal(10, 2) // 快照：供货价
  snapshotLevel1Price Decimal? @db.Decimal(10, 2) // 快照：一级给二级的价
  snapshotRetailPrice Decimal? @db.Decimal(10, 2) // 快照：成交零售价

  // 利润分配
  masterProfit  Decimal @default(0) @db.Decimal(10, 2) // 总代理利润
  level1Profit  Decimal @default(0) @db.Decimal(10, 2) // 一级推销员利润
  level2Profit  Decimal @default(0) @db.Decimal(10, 2) // 二级推销员利润
  level1AgentId Int? // 一级推销员ID
  level2AgentId Int? // 二级推销员ID

  // 收款确认（增强）
  paymentConfirmed   Boolean   @default(false) // 收款已确认
  paymentConfirmedAt DateTime? // 收款确认时间
  paymentMethod      String?   @db.VarChar(20) // 收款方式: cash/scan/transfer

  // 利润结算（T+2）
  profitSettled   Boolean   @default(false) // 利润已结算
  profitSettledAt DateTime? // 利润结算时间

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items           OrderItem[]
  commissions     Commission[]
  transferTask    TransferTask?
  exceptionOrders ExceptionOrder[]
  confirmLogs     OrderConfirmLog[]

  @@index([agentId])
  @@index([status])
  @@index([needConfirm])
  @@index([warehouseId])
  @@index([orderSource])
  @@index([sourceAgentId])
  @@map("orders")
}

// 订单确认日志
model OrderConfirmLog {
  id Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // 操作人
  operatorId   Int // 操作人ID
  operatorType String  @db.VarChar(20) // AGENT(代理商) / ADMIN(管理员)
  operatorName String? @db.VarChar(50) // 操作人名称

  // 操作类型: CONFIRM(确认) / TIMEOUT(超时) / CS_CONFIRM(客服确认)
  action String @db.VarChar(20)

  remark    String?  @db.VarChar(255)
  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_confirm_logs")
}

// 订单商品
model OrderItem {
  id      Int   @id @default(autoincrement())
  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  productId Int
  product   Product @relation(fields: [productId], references: [id])

  productName  String  @db.VarChar(100)
  productImage String? @db.VarChar(500)
  price        Decimal @db.Decimal(10, 2)
  quantity     Int
  specs        String? @db.Text

  // 【2026-01-16 推广体系升级】商品级价格快照
  snapshotCostPrice   Decimal? @db.Decimal(10, 2) // 成本价快照
  snapshotSupplyPrice Decimal? @db.Decimal(10, 2) // 供货价快照
  snapshotLevel1Price Decimal? @db.Decimal(10, 2) // 一级给二级价格快照
  snapshotRetailPrice Decimal? @db.Decimal(10, 2) // 零售价快照

  @@index([orderId])
  @@map("order_items")
}

// ============ 分润相关 ============

// 分润规则
model CommissionRule {
  id Int @id @default(autoincrement())

  // 订单金额阈值
  minAmount Decimal @db.Decimal(10, 2)

  // 分润比例（百分比）
  level1Rate Decimal @db.Decimal(5, 2) // 一级代理分润
  level2Rate Decimal @db.Decimal(5, 2) // 二级代理分润

  status    String   @default("ACTIVE") @db.VarChar(20)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("commission_rules")
}

// 分润记录
model Commission {
  id Int @id @default(autoincrement())

  agentId Int
  agent   Agent @relation(fields: [agentId], references: [id])

  orderId Int
  order   Order @relation(fields: [orderId], references: [id])

  // 分润金额
  amount Decimal @db.Decimal(10, 2)
  rate   Decimal @db.Decimal(5, 2) // 分润比例

  // 分润类型: DIRECT(直接分润), INDIRECT(间接分润)
  type String @db.VarChar(20)

  // 状态: PENDING(待结算), SETTLED(已结算), CANCELLED(已取消)
  status String @default("PENDING") @db.VarChar(20)

  settledAt DateTime?
  createdAt DateTime  @default(now())

  @@index([agentId])
  @@index([orderId])
  @@map("commissions")
}

// 提现记录
